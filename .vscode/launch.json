{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Dev Server (Fullstack)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "restart": true,
      "internalConsoleOptions": "neverOpen",
      "port": 9229
    },
    {
      "name": "Launch Chrome against localhost",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/src"
    }
  ],
  "compounds": [
    {
      "name": "Fullstack: Server + Chrome",
      "configurations": ["Dev Server (Fullstack)", "Launch Chrome against localhost"]
    }
  ]
}
